{
  "manifest_version": 3,
  "name": "YouTube Review — Gemini Analysis",
  "version": "0.2.0",
  "description": "Creates concise, structured video reports with Gemini.",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ]
}
