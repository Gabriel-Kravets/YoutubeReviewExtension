{
  "manifest_version": 3,
  "name": "SpoilIt — Interface",
  "version": "0.2.0",
  "description": "A polished spoiler report displayed beside YouTube videos.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["panel.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ]
}
